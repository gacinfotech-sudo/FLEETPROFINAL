{
  "openapi": "3.0.0",
  "info": {
    "title": "FleetPro SaaS Platform API",
    "description": "Comprehensive REST API for Fleet Management, Driver Operations, Analytics, and Business Intelligence. Features 277+ endpoints covering authentication, vehicle tracking, driver management, financial operations, notifications, and advanced analytics.",
    "version": "1.0.0",
    "contact": {
      "name": "FleetPro API Support",
      "email": "api@fleetpro.com",
      "url": "https://fleetpro.com/support"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://fleetpro.com/license"
    },
    "x-logo": {
      "url": "https://fleetpro.com/logo.png",
      "altText": "FleetPro"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5050/api",
      "description": "Development Server",
      "variables": {
        "port": {
          "default": "5050"
        }
      }
    },
    {
      "url": "https://api.fleetpro.com/api",
      "description": "Production Server",
      "x-internal": false
    },
    {
      "url": "https://staging-api.fleetpro.com/api",
      "description": "Staging Server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "sessionAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "User authentication, login, session management, and JWT token operations"
    },
    {
      "name": "Platform Admin",
      "description": "Platform-level administration, tenant management, user management, and system configuration"
    },
    {
      "name": "Tenant Management",
      "description": "Multi-tenant features, tenant configuration, and tenant-specific settings"
    },
    {
      "name": "Drivers",
      "description": "Driver CRUD operations, driver profiles, driver portal, and driver-specific features"
    },
    {
      "name": "Vehicles",
      "description": "Vehicle management, vehicle tracking, vehicle maintenance, and vehicle analytics"
    },
    {
      "name": "Bookings & Trips",
      "description": "Booking management, trip operations, routing, and dispatch optimization"
    },
    {
      "name": "Analytics & Reports",
      "description": "Analytics dashboards, reporting endpoints, KPI tracking, and business intelligence"
    },
    {
      "name": "Notifications",
      "description": "Notification management, templates, delivery, webhooks, and notification preferences"
    },
    {
      "name": "Financial",
      "description": "Driver salary, payments, billing, invoicing, financial analytics, and GST management"
    },
    {
      "name": "Safety & Incidents",
      "description": "Accident reporting, safety incidents, incident management, and safety analytics"
    },
    {
      "name": "Maintenance",
      "description": "Vehicle maintenance schedules, maintenance tracking, and preventive maintenance"
    },
    {
      "name": "Integrations",
      "description": "Third-party integrations, webhook management, and integration configuration"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User Login",
        "description": "Authenticate user with email and password. Returns JWT token for subsequent API calls.",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@fleetpro.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 8,
                    "example": "SecurePassword123!"
                  },
                  "rememberMe": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "token": {
                      "type": "string",
                      "description": "JWT Bearer token",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    },
                    "refreshToken": {
                      "type": "string",
                      "description": "Refresh token for obtaining new JWT"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    },
                    "tenant": {
                      "$ref": "#/components/schemas/Tenant"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitError"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Refresh JWT Token",
        "description": "Obtain new JWT token using refresh token",
        "operationId": "refreshToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token refreshed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "refreshToken": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Logout User",
        "description": "Invalidate current session and JWT token",
        "operationId": "logout",
        "security": [
          {"bearerAuth": []}
        ],
        "responses": {
          "200": {
            "description": "Logout successful"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get Current User",
        "description": "Retrieve authenticated user profile information",
        "operationId": "getCurrentUser",
        "security": [
          {"bearerAuth": []}
        ],
        "responses": {
          "200": {
            "description": "Current user information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/drivers": {
      "get": {
        "tags": ["Drivers"],
        "summary": "List All Drivers",
        "description": "Retrieve paginated list of drivers for the tenant",
        "operationId": "listDrivers",
        "security": [
          {"bearerAuth": []}
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["active", "inactive", "on-leave", "suspended"]
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of drivers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Driver"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Drivers"],
        "summary": "Create Driver",
        "description": "Create a new driver for the tenant",
        "operationId": "createDriver",
        "security": [
          {"bearerAuth": []}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriverInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Driver created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Driver"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/drivers/{driverId}": {
      "get": {
        "tags": ["Drivers"],
        "summary": "Get Driver Details",
        "description": "Retrieve detailed information about a specific driver",
        "operationId": "getDriver",
        "security": [
          {"bearerAuth": []}
        ],
        "parameters": [
          {
            "name": "driverId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Driver details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Driver"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "put": {
        "tags": ["Drivers"],
        "summary": "Update Driver",
        "description": "Update driver information",
        "operationId": "updateDriver",
        "security": [
          {"bearerAuth": []}
        ],
        "parameters": [
          {
            "name": "driverId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriverInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Driver updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Driver"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Drivers"],
        "summary": "Delete Driver",
        "description": "Delete a driver (soft delete)",
        "operationId": "deleteDriver",
        "security": [
          {"bearerAuth": []}
        ],
        "parameters": [
          {
            "name": "driverId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Driver deleted successfully"
          }
        }
      }
    },
    "/vehicles": {
      "get": {
        "tags": ["Vehicles"],
        "summary": "List All Vehicles",
        "description": "Retrieve paginated list of vehicles",
        "operationId": "listVehicles",
        "security": [
          {"bearerAuth": []}
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of vehicles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Vehicle"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Vehicles"],
        "summary": "Create Vehicle",
        "description": "Create a new vehicle",
        "operationId": "createVehicle",
        "security": [
          {"bearerAuth": []}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VehicleInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vehicle created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Vehicle"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/dashboard": {
      "get": {
        "tags": ["Analytics & Reports"],
        "summary": "Get Analytics Dashboard",
        "description": "Retrieve comprehensive analytics dashboard data including KPIs, trends, and insights",
        "operationId": "getAnalyticsDashboard",
        "security": [
          {"bearerAuth": []}
        ],
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["today", "week", "month", "quarter", "year"],
              "default": "month"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Analytics dashboard data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "summary": {
                      "type": "object",
                      "properties": {
                        "totalTrips": {"type": "integer"},
                        "totalRevenue": {"type": "number"},
                        "activeDrivers": {"type": "integer"},
                        "fleetUtilization": {"type": "number"}
                      }
                    },
                    "charts": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "tags": ["Notifications"],
        "summary": "List Notifications",
        "description": "Retrieve user notifications with filtering and pagination",
        "operationId": "listNotifications",
        "security": [
          {"bearerAuth": []}
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "read",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of notifications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Notification"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Notifications"],
        "summary": "Send Notification",
        "description": "Send a notification to specified recipients",
        "operationId": "sendNotification",
        "security": [
          {"bearerAuth": []}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "message", "recipients"],
                "properties": {
                  "title": {"type": "string"},
                  "message": {"type": "string"},
                  "recipients": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "type": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Notification sent successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "email": {"type": "string", "format": "email"},
          "name": {"type": "string"},
          "role": {"type": "string", "enum": ["admin", "manager", "user"]},
          "tenantId": {"type": "string"},
          "permissions": {"type": "array", "items": {"type": "string"}},
          "createdAt": {"type": "string", "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"}
        }
      },
      "Tenant": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "businessType": {"type": "string"},
          "status": {"type": "string"},
          "subscriptionPlan": {"type": "string"}
        }
      },
      "Driver": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "email": {"type": "string"},
          "phone": {"type": "string"},
          "licenseNumber": {"type": "string"},
          "status": {"type": "string"},
          "dateOfJoining": {"type": "string", "format": "date"},
          "salary": {"type": "number"},
          "documents": {"type": "object"}
        }
      },
      "DriverInput": {
        "type": "object",
        "required": ["name", "phone", "licenseNumber"],
        "properties": {
          "name": {"type": "string"},
          "email": {"type": "string", "format": "email"},
          "phone": {"type": "string"},
          "licenseNumber": {"type": "string"},
          "dateOfJoining": {"type": "string", "format": "date"},
          "salary": {"type": "number"}
        }
      },
      "Vehicle": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "registrationNumber": {"type": "string"},
          "model": {"type": "string"},
          "manufacturer": {"type": "string"},
          "type": {"type": "string"},
          "capacity": {"type": "number"},
          "status": {"type": "string"}
        }
      },
      "VehicleInput": {
        "type": "object",
        "required": ["registrationNumber", "model", "manufacturer"],
        "properties": {
          "registrationNumber": {"type": "string"},
          "model": {"type": "string"},
          "manufacturer": {"type": "string"},
          "type": {"type": "string"},
          "capacity": {"type": "number"}
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "message": {"type": "string"},
          "type": {"type": "string"},
          "read": {"type": "boolean"},
          "createdAt": {"type": "string", "format": "date-time"}
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {"type": "integer"},
          "limit": {"type": "integer"},
          "total": {"type": "integer"},
          "pages": {"type": "integer"}
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {"type": "string"},
          "code": {"type": "string"},
          "details": {"type": "object"}
        }
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Authentication required or invalid credentials",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation error in request body",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimitError": {
        "description": "Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token for API authentication"
      },
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionId",
        "description": "Session cookie-based authentication"
      }
    }
  },
  "x-internal": false
}
