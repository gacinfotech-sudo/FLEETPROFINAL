# FleetPro Production Environment Configuration
# IMPORTANT: This is a template. Copy to .env.production and fill in actual values.
# NEVER commit .env.production to version control!

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
# Production mode optimizations
NODE_ENV=production
PORT=5050

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MongoDB Connection String - Update with production credentials
# Format: mongodb://[username:password@]host[:port]/database?options
MONGODB_ROOT_USER=admin
MONGODB_ROOT_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
MONGODB_URI=mongodb://admin:GENERATE_SECURE_PASSWORD_HERE@mongodb:27017/fleetpro?authSource=admin&replicaSet=rs0

# Connection pool settings for optimal performance
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT=10000
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_SOCKET_KEEP_ALIVE=true
MONGODB_SOCKET_KEEP_ALIVE_TIMEOUT=30000

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================
# Redis connection for sessions, caching, and pub/sub
REDIS_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
REDIS_URL=redis://:GENERATE_SECURE_PASSWORD_HERE@redis:6379/0
REDIS_POOL_SIZE=20
REDIS_TIMEOUT=3000

# Redis cluster mode (set to true if using Redis cluster)
REDIS_CLUSTER=false

# ============================================================================
# SESSION MANAGEMENT
# ============================================================================
# Session secret for signing cookies - Generate a strong random string
# openssl rand -base64 32
SESSION_SECRET=GENERATE_SECURE_SESSION_SECRET_HERE
SESSION_NAME=fleetpro.sid
SESSION_TIMEOUT=3600000  # 1 hour in milliseconds
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=strict

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# JWT secret for signing tokens
# openssl rand -base64 32
JWT_SECRET=GENERATE_SECURE_JWT_SECRET_HERE
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# ============================================================================
# PUSH NOTIFICATIONS - VAPID KEYS
# ============================================================================
# Web Push VAPID keys - Generate with: npm install -g web-push && web-push generate-vapid-keys
# IMPORTANT: Keep PRIVATE key SECRET and NEVER commit it
VITE_VAPID_PUBLIC_KEY=GENERATE_VAPID_PUBLIC_KEY_HERE
SERVER_VAPID_PRIVATE_KEY=GENERATE_VAPID_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:support@fleetpro.local

# Push notification settings
NOTIFICATION_ENABLED=true
BACKGROUND_SYNC_ENABLED=true
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_BATCH_TIMEOUT=5000

# ============================================================================
# WHATSAPP INTEGRATION
# ============================================================================
# WhatsApp Business Account Configuration
WHATSAPP_PHONE_NUMBER_ID=GENERATE_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=GENERATE_WHATSAPP_BUSINESS_ACCOUNT_ID
WHATSAPP_PROVIDER=mock  # Options: local, production, mock
WHATSAPP_API_TOKEN=GENERATE_WHATSAPP_API_TOKEN
WHATSAPP_API_ENDPOINT=https://graph.instagram.com/v18.0

# Webhook verification - Generate a random token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=GENERATE_WEBHOOK_VERIFY_TOKEN
WHATSAPP_API_VERSION=v18.0

# ============================================================================
# EMAIL CONFIGURATION (SendGrid, Gmail, etc.)
# ============================================================================
# Email service provider - Options: sendgrid, gmail, smtp, mock
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@fleetpro.local
EMAIL_FROM_NAME=FleetPro Notifications

# SendGrid Configuration
SENDGRID_API_KEY=GENERATE_SENDGRID_API_KEY

# Gmail SMTP Configuration (if using Gmail)
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=your-gmail@gmail.com
GMAIL_SMTP_PASSWORD=GENERATE_GMAIL_APP_PASSWORD

# Generic SMTP Configuration
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=GENERATE_SMTP_PASSWORD
SMTP_TLS=true

# ============================================================================
# SMS CONFIGURATION (Twilio, Telco APIs)
# ============================================================================
# SMS service provider - Options: twilio, local, mock
SMS_PROVIDER=twilio

# Twilio Configuration
TWILIO_ACCOUNT_SID=GENERATE_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=GENERATE_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================
# Stripe Integration
STRIPE_API_KEY=sk_live_GENERATE_STRIPE_API_KEY
STRIPE_PUBLIC_KEY=pk_live_GENERATE_STRIPE_PUBLIC_KEY
STRIPE_WEBHOOK_SECRET=whsec_GENERATE_WEBHOOK_SECRET

# Razorpay Integration (for India)
RAZORPAY_API_KEY=GENERATE_RAZORPAY_API_KEY
RAZORPAY_API_SECRET=GENERATE_RAZORPAY_API_SECRET

# ============================================================================
# EXTERNAL APIs
# ============================================================================
# Google Maps API
GOOGLE_MAPS_API_KEY=GENERATE_GOOGLE_MAPS_API_KEY

# Google Places API
GOOGLE_PLACES_API_KEY=GENERATE_GOOGLE_PLACES_API_KEY

# Weather API
WEATHER_API_PROVIDER=openweathermap
WEATHER_API_KEY=GENERATE_WEATHER_API_KEY

# ============================================================================
# SSL/TLS CONFIGURATION
# ============================================================================
# SSL certificate paths (Docker volumes)
SSL_CERT_PATH=/etc/nginx/ssl/certs/fleetpro.crt
SSL_KEY_PATH=/etc/nginx/ssl/private/fleetpro.key
SSL_CA_PATH=/etc/nginx/ssl/certs/ca-bundle.crt

# HTTPS configuration
HTTPS_ENABLED=true
HTTPS_ONLY=true
SSL_PROTOCOLS=TLSv1.2 TLSv1.3
SSL_CIPHERS=HIGH:!aNULL:!MD5

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ENABLED=true
CORS_ORIGIN=https://fleetpro.example.com,https://app.fleetpro.example.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log levels: EMERGENCY, ALERT, CRITICAL, ERROR, WARNING, NOTICE, INFO, DEBUG
LOG_LEVEL=INFO
LOG_FORMAT=json  # Options: json, text, pretty

# Log destinations
LOG_FILE=/app/logs/fleetpro.log
LOG_ERROR_FILE=/app/logs/error.log
LOG_REQUEST_FILE=/app/logs/requests.log

# Log rotation
LOG_MAX_SIZE=50m
LOG_MAX_FILES=5
LOG_RETENTION_DAYS=30

# Log sampling (send to external service every N requests)
LOG_SAMPLE_RATE=1  # 1 = all, 0.1 = 10%, 0.01 = 1%

# ============================================================================
# OBSERVABILITY & MONITORING
# ============================================================================
# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH=/metrics

# Jaeger distributed tracing
JAEGER_ENABLED=true
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=0.1  # 10% sampling rate
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# Elasticsearch logging
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_HOST=elasticsearch:9200
ELASTICSEARCH_INDEX=fleetpro-logs

# Health check endpoints
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_DETAILED_PATH=/health/detailed

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_GLOBAL_ENABLED=true
RATE_LIMIT_BY_IP=true
RATE_LIMIT_BY_USER=true

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
# Connection timeouts (milliseconds)
CONNECTION_TIMEOUT=30000
REQUEST_TIMEOUT=60000
KEEPALIVE_TIMEOUT=65000

# Compression settings
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6  # 1-9, higher = more compression but slower
COMPRESSION_THRESHOLD=1024  # Minimum size to compress

# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600  # seconds
CACHE_MAX_SIZE=1000  # max entries in memory

# ============================================================================
# SECURITY HEADERS
# ============================================================================
# Strict-Transport-Security (HSTS)
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Content Security Policy (CSP)
CSP_ENABLED=true
CSP_REPORT_ONLY=false

# X-Frame-Options (Clickjacking protection)
X_FRAME_OPTIONS=DENY

# X-Content-Type-Options
X_CONTENT_TYPE_OPTIONS=nosniff

# Referrer-Policy
REFERRER_POLICY=strict-origin-when-cross-origin

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================
# Backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM UTC
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/fleetpro

# Automatic backup upload to cloud storage
BACKUP_TO_S3_ENABLED=false
AWS_S3_BUCKET=fleetpro-backups
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=GENERATE_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=GENERATE_AWS_SECRET_KEY

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_NOTIFICATIONS=true
FEATURE_GPS_TRACKING=true
FEATURE_WHATSAPP_INTEGRATION=true
FEATURE_PAYMENT_GATEWAY=true
FEATURE_EMAIL_TEMPLATES=true
FEATURE_ANALYTICS=true
FEATURE_EXPORT_REPORTS=true
FEATURE_API_V2=false

# ============================================================================
# ADMIN SETTINGS
# ============================================================================
# Admin panel access
ADMIN_PANEL_ENABLED=true
ADMIN_PATH=/admin
ADMIN_SESSION_TIMEOUT=1800000  # 30 minutes

# Audit logging
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_FILE=/app/logs/audit.log

# ============================================================================
# MAINTENANCE MODE
# ============================================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System under maintenance. Please try again later.
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1

# ============================================================================
# DEPLOYMENT METADATA
# ============================================================================
DEPLOYMENT_ENVIRONMENT=production
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_BUILD_ID=WILL_BE_SET_AT_DEPLOYMENT_TIME
DEPLOYMENT_TIMESTAMP=WILL_BE_SET_AT_DEPLOYMENT_TIME
