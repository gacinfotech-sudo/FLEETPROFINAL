# FleetPro Environment Configuration

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/fleetpro

# Node Environment
NODE_ENV=development
PORT=5050

# Sessions
SESSION_SECRET=your-session-secret-key-here

# JWT
JWT_SECRET=your-jwt-secret-key-here

# VAPID Keys for Push Notifications
# Generate with: npm install -g web-push && web-push generate-vapid-keys
# Keep PRIVATE key SECRET and NEVER commit it
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
SERVER_VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:support@fleetpro.local

# Push Notifications
NOTIFICATION_ENABLED=true
BACKGROUND_SYNC_ENABLED=true

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_PROVIDER=local
WHATSAPP_API_TOKEN=your-api-token

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGIN=http://localhost:5050

# API Keys (Optional)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
STRIPE_API_KEY=your-stripe-api-key
