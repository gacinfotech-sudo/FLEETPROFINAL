# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (required). Use a MongoDB Atlas replica set in
# production so the transactional booking-overlap check gets full atomicity.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fleetpro

# Session signing secret (required). Generate with: openssl rand -hex 32
# Must be at least 32 characters. The server will refuse to start without it.
SESSION_SECRET=

# development | production
NODE_ENV=development

# Port the server listens on. Most hosting platforms (Render, Heroku, etc.)
# set this for you automatically — leave unset in that case.
PORT=5000

# Number of trusted reverse-proxy hops in production. Keep this at 1 for a
# normal single ingress/load-balancer setup; set it to match your real chain.
TRUST_PROXY_HOPS=1

# --- Emergency admin recovery (optional, use only during an actual lockout) ---
# If both are set, the server creates this admin user on startup (once) with
# mustResetPassword=true. Remove these two variables again immediately after
# recovering access.
EMERGENCY_ADMIN_ID=
EMERGENCY_ADMIN_PASSWORD=
