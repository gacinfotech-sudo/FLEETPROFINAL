# FleetPro Environment Configuration

# Server
NODE_ENV=development
PORT=5051
LOG_LEVEL=debug

# Database
MONGODB_URI=mongodb://localhost:27017/fleetpro

# Session & Auth
SESSION_SECRET=your-very-long-random-secret-minimum-32-characters-required
JWT_SECRET=your-jwt-secret-minimum-32-characters
JWT_EXPIRY=24h

# CORS & Security
CORS_ORIGIN=https://localhost:5051
SECURE_COOKIES=true
RATE_LIMIT=10

# Email Service (Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM=noreply@fleetpro.local

# Payment Gateway (Optional)
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
RAZORPAY_KEY_ID=your_razorpay_key

# Cloud Storage (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=fleetpro-uploads

# Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn-url
DATADOG_API_KEY=your-datadog-key
GOOGLE_ANALYTICS_ID=your-ga-id

# Feature Flags
ENABLE_NOTIFICATIONS=true
ENABLE_PAYMENTS=false
ENABLE_ANALYTICS=true
ENABLE_REPORTING=true

# Debug
DEBUG=false
VERBOSE_LOGGING=false
